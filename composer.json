{
    "name": "assegaiphp/core",
    "description": "A structured PHP framework for building modular APIs and server-side applications.",
    "type": "library",
    "require-dev": {
        "codeception/codeception": "^5.3.5",
        "codeception/module-phpbrowser": "*",
        "codeception/module-asserts": "*",
        "phpstan/phpstan": "^1.11"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Assegai\\Core\\": "src/"
        },
        "files": [
            "src/Util/Definitions.php",
            "src/Util/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Assegai\\Form\\": "../forms/src/",
            "Tests\\Mocks\\": "tests/Mocks/"
        }
    },
    "authors": [
        {
            "name": "Andrew Masiye",
            "email": "amasiye313@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.4",
        "twig/twig": "^3.10",
        "ext-fileinfo": "*",
        "assegaiphp/validation": "^0.10.0",
        "assegaiphp/util": "^0.10.0",
        "assegaiphp/forms": "^0.10.0",
        "filp/whoops": "^2.15",
        "twig/markdown-extra": "^3.10",
        "erusev/parsedown": "^1.7",
        "symfony/console": "^8.0",
        "assegaiphp/attributes": "^1.0",
        "assegaiphp/common": "^0.10.0",
        "jimmiw/php-time-ago": "^3.3"
    },
    "scripts": {
        "test": "php -d register_argc_argv=On -d error_reporting=-1 vendor/bin/codecept run Unit",
        "analyze": "vendor/bin/phpstan analyse src --level 8"
    }
}
